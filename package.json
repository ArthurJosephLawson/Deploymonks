{
  "name": "deploymonk",
  "version": "1.0.0",
  "description": "Scaffold polished full-stack project boilerplates into any directory, from a friendly interactive terminal experience.",
  "keywords": [
    "cli",
    "scaffold",
    "scaffolding",
    "generator",
    "boilerplate",
    "template",
    "templates",
    "starter",
    "starter-kit",
    "fastapi",
    "express",
    "tailwind",
    "developer-tools",
    "project-generator"
  ],
  "homepage": "https://github.com/monk_mango/deploymonk#readme",
  "bugs": {
    "url": "https://github.com/monk_mango/deploymonk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monk_mango/deploymonk.git"
  },
  "license": "MIT",
  "author": {
    "name": "ArthurJosephLawson",
    "url": "https://github.com/monk_mango",
    "role": "Principal, Scriptmonks"
  },
  "contributors": [
    {
      "name": "ArthurJosephLawson",
      "url": "https://github.com/monk_mango"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "deploymonk": "bin/deploymonk.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.mjs",
    "prepack": "npm run clean && npm run verify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm run build && npm test && npm run smoke",
    "prepare": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^12.2.3",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
